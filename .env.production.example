# Frontend – production build (no trailing slash)
# Single domain (app at https://yourdomain.com, API at /api):
VITE_API_URL=https://yourdomain.com

# Subdomains — use the API host (not app) so uploads hit nginx client_max_body_size on api.*; otherwise app.* can return 413:
# VITE_API_URL=https://api.yourdomain.com
