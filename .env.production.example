# Frontend – production build (no trailing slash)
# Single domain (app at https://yourdomain.com, API at /api):
VITE_API_URL=https://yourdomain.com

# Subdomains — use the API host (not app) so uploads hit nginx client_max_body_size on api.*; otherwise app.* can return 413:
# VITE_API_URL=https://api.yourdomain.com
#
# Socket.IO: on app.* the build uses same-origin wss://app.../socket.io (nginx → Node). Override only if needed:
# VITE_SOCKET_URL=https://api.yourdomain.com
#
# iOS/Android (Capacitor): always uses VITE_API_URL for sockets (https://api...). After changing env:
#   npm run cap:sync:ios

# Google Analytics 4 (optional; base gtag also in index.html)
VITE_GA_MEASUREMENT_ID=G-NHY9GW6GKG
